<Window x:Class="NetworkAccessManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1320"
        Height="720"
        MinWidth="1120"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/app.ico"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- Header: title, data location and primary tools. Compact like a classic desktop manager. -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0,10,0" Height="47">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/app.ico" Width="22" Height="22" Margin="0,0,8,0" />
                    <TextBlock Text="网络访问管理器" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Style="{StaticResource InfoBadgeBorderStyle}" Margin="8,0,0,0">
                        <TextBlock Text="{Binding VersionText, StringFormat=版本 {0}}" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Text="{Binding DataDirectory, StringFormat=数据：{0}}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DataDirectory}"
                           MaxWidth="300" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding EthernetToggleText}" Style="{StaticResource ToolbarButtonStyle}" Click="EthernetToggleButton_Click"
                            IsEnabled="{Binding CanToggleEthernet}" ToolTip="{Binding EthernetDetailText}" MinWidth="88" />
                    <Button Content="延迟禁网…" Style="{StaticResource ToolbarButtonStyle}" Click="EthernetScheduleButton_Click"
                            IsEnabled="{Binding CanScheduleEthernetDisable}" ToolTip="安排一个延迟任务，到点后禁用所有物理以太网适配器" MinWidth="88" />
                    <Button Content="刷新 (F5)" Style="{StaticResource ToolbarButtonStyle}" Click="RefreshButton_Click" IsEnabled="{Binding IsRefreshButtonEnabled}" />
                    <Button Content="按网络目标禁止…" Style="{StaticResource ToolbarButtonStyle}" Click="NetworkTargetButton_Click" MinWidth="112" />
                    <Button Content="设置" Style="{StaticResource ToolbarButtonStyle}" Click="SettingsButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status strip: every value comes from actual state. -->
        <Border Grid.Row="1" Background="{StaticResource HeaderSurfaceBrush}" BorderBrush="{StaticResource LightBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Height="31" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding PrivilegeHint}">
                    <TextBlock Text="权限" Style="{StaticResource FieldLabelStyle}" />
                    <Ellipse Width="7" Height="7" Fill="{Binding PrivilegeBrush}" Margin="7,0,5,0" />
                    <TextBlock Text="{Binding PrivilegeStatusText}" Style="{StaticResource FieldValueStyle}" />
                    <Border Width="1" Height="15" Background="{StaticResource LightBorderBrush}" Margin="10,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="网络监控" Style="{StaticResource FieldLabelStyle}" />
                    <Ellipse Width="7" Height="7" Fill="{Binding MonitorStatusBrush}" Margin="7,0,5,0" />
                    <TextBlock Text="{Binding MonitorStatusText}" Style="{StaticResource FieldValueStyle}" />
                    <Border Width="1" Height="15" Background="{StaticResource LightBorderBrush}" Margin="10,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="最近刷新" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Text="{Binding LastRefreshText}" Style="{StaticResource FieldValueStyle}" Margin="7,0,0,0" />
                    <Border Width="1" Height="15" Background="{StaticResource LightBorderBrush}" Margin="10,0" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding FirewallError}">
                    <TextBlock Text="Windows 防火墙" Style="{StaticResource FieldLabelStyle}" />
                    <Ellipse Width="7" Height="7" Fill="{Binding FirewallStatusBrush}" Margin="7,0,5,0" />
                    <TextBlock Text="{Binding FirewallStatusText}" Style="{StaticResource FieldValueStyle}" />
                    <TextBlock Text="{Binding FirewallDetailText}" Style="{StaticResource SmallMutedTextStyle}" Margin="7,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="245" />
                </StackPanel>

                <ProgressBar Grid.Column="4" Height="3" IsIndeterminate="True" Margin="12,0" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource AccentBrush}" />

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PendingTaskText}" Style="{StaticResource SmallMutedTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Warning strip. Persistent warnings are never hidden behind a fake normal state. -->
        <Border Grid.Row="2"
                Background="{StaticResource WarningBackgroundBrush}"
                BorderBrush="{StaticResource WarningBorderBrush}"
                BorderThickness="0,1,0,1"
                Padding="11,4"
                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}"
                ToolTip="{Binding WarningTooltip}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="!" FontWeight="Bold" Foreground="{Binding WarningForeground}" Margin="0,0,7,0" />
                <TextBlock Grid.Column="1" Text="{Binding WarningText}" Foreground="{Binding WarningForeground}" TextWrapping="Wrap" MaxHeight="34" />
            </Grid>
        </Border>

        <!-- Main split: application/network data on the left, system/service processes on the right. -->
        <Grid Grid.Row="3" Margin="8,7,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="600" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource HeaderSurfaceBrush}" BorderBrush="{StaticResource LightBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="应用与网络" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="真实进程、TCP / UDP 连接与策略" Style="{StaticResource SectionSubtleTitleStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SmallMutedTextStyle}">
                                <Run Text="进程 " /><Run Text="{Binding AppProcessCountText, Mode=OneWay}" /><Run Text=" · 连接 " /><Run Text="{Binding ConnectionCountText, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </Border>

                    <TabControl x:Name="LeftTabs" Grid.Row="1" SelectionChanged="LeftTabs_SelectionChanged">
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock>
                                    <Run Text="应用进程  " />
                                    <Run Text="{Binding AppProcessCountText, Mode=OneWay}" />
                                </TextBlock>
                            </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="25" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="8,6,8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="搜索" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" />
                                    <TextBox x:Name="AppProcessSearchBox" Grid.Column="1" Text="{Binding AppProcessSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="按应用名、进程名、PID、路径搜索" />
                                    <TextBlock Grid.Column="2" Text="筛选" Style="{StaticResource FieldLabelStyle}" Margin="10,0,6,0" />
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding AppProcessFilters}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding AppProcessFilterKey}" />
                                    <TextBlock Grid.Column="4" Text="多选：Ctrl / Shift；双击查看完整详情" Style="{StaticResource SmallMutedTextStyle}" HorizontalAlignment="Right" />
                                </Grid>

                                <DataGrid x:Name="AppProcessGrid"
                                          Grid.Row="1"
                                          Style="{StaticResource DataGridStyle}"
                                          ItemsSource="{Binding AppProcessView}"
                                          SelectionChanged="AppProcessGrid_SelectionChanged"
                                          MouseDoubleClick="Grid_MouseDoubleClick">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="立即禁止…" Click="ContextBlock_Click" />
                                            <MenuItem Header="延迟禁止 / 解除…" Click="ContextSchedule_Click" />
                                            <MenuItem Header="解除本工具规则…" Click="ContextUnblock_Click" />
                                            <Separator />
                                            <MenuItem Header="查看完整详情…" Click="OpenDetails_Click" />
                                            <MenuItem Header="复制可执行文件路径" Click="CopySelectedPath_Click" />
                                            <MenuItem Header="在资源管理器中定位" Click="OpenSelectedPath_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="状态" Width="68" SortMemberPath="StateText">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="进程在最近一次系统快照中存在">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" Margin="0,0,5,0" />
                                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource GridCellTextStyle}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="应用名称" Binding="{Binding DisplayName}" Width="160" SortMemberPath="DisplayName" ElementStyle="{StaticResource GridCellTextStyle}" />
                                        <DataGridTextColumn Header="进程名称" Binding="{Binding ProcessName}" Width="115" SortMemberPath="ProcessName" ElementStyle="{StaticResource GridCellTextStyle}" />
                                        <DataGridTextColumn Header="PID" Binding="{Binding PidText}" Width="70" SortMemberPath="Pid" ElementStyle="{StaticResource GridCellTextStyle}" />
                                        <DataGridTemplateColumn Header="网络" Width="82" SortMemberPath="NetworkStatusText">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ConnectionCountText}">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding NetworkStatusBrush}" Margin="0,0,5,0" />
                                                        <TextBlock Text="{Binding NetworkStatusText}" Style="{StaticResource GridCellTextStyle}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="连接" Binding="{Binding ConnectionCountText}" Width="88" SortMemberPath="ConnectionCount" ElementStyle="{StaticResource GridCellTextStyle}" />
                                        <DataGridTemplateColumn Header="策略状态" Width="160" SortMemberPath="PolicyText">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding PolicyBackground}" CornerRadius="2" Padding="5,1" HorizontalAlignment="Left" ToolTip="{Binding PolicyDetail}">
                                                        <TextBlock Text="{Binding PolicyText}" Foreground="{Binding PolicyBrush}" Style="{StaticResource GridCellTextStyle}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="说明" Binding="{Binding Notes}" Width="235" ElementStyle="{StaticResource GridCellTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="2" Background="{StaticResource HeaderSurfaceBrush}" BorderBrush="{StaticResource LightBorderBrush}" BorderThickness="0,1,0,0">
                                    <Grid Margin="8,0">
                                        <TextBlock Text="{Binding AppProcessVisibleText}" Style="{StaticResource SmallMutedTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedCountText}" Style="{StaticResource SmallMutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <TextBlock>
                                    <Run Text="网络连接  " />
                                    <Run Text="{Binding ConnectionCountText, Mode=OneWay}" />
                                </TextBlock>
                            </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="25" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="8,6,8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="搜索" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" />
                                    <TextBox x:Name="ConnectionSearchBox" Grid.Column="1" Text="{Binding ConnectionSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="按进程名、PID、本地/远程 IP、端口搜索" />
                                    <TextBlock Grid.Column="2" Text="筛选" Style="{StaticResource FieldLabelStyle}" Margin="10,0,6,0" />
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding ConnectionFilters}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding ConnectionFilterKey}" />
                                    <TextBlock Grid.Column="4" Text="连接数据来自 Windows TCP/UDP 表" Style="{StaticResource SmallMutedTextStyle}" HorizontalAlignment="Right" />
                                </Grid>

                                <DataGrid x:Name="ConnectionGrid"
                                          Grid.Row="1"
                                          Style="{StaticResource DataGridStyle}"
                                          ItemsSource="{Binding ConnectionView}"
                                          SelectionChanged="ConnectionGrid_SelectionChanged"
                                          MouseDoubleClick="Grid_MouseDoubleClick">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="立即禁止…" Click="ContextBlock_Click" />
                                            <MenuItem Header="延迟禁止 / 解除…" Click="ContextSchedule_Click" />
                                            <MenuItem Header="解除本工具规则…" Click="ContextUnblock_Click" />
                                            <Separator />
                                            <MenuItem Header="查看完整详情…" Click="OpenDetails_Click" />
                                            <MenuItem Header="复制进程路径" Click="CopySelectedPath_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="状态" Width="92" SortMemberPath="ActivityText">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding ActivityBrush}" Margin="0,0,5,0" />
                                                        <TextBlock Text="{Binding ActivityText}" Style="{StaticResource GridCellTextStyle}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="所属进程" Binding="{Binding ProcessDisplayName}" Width="150" SortMemberPath="ProcessDisplayName" ElementStyle="{StaticResource GridCellTextStyle}" />
                                        <DataGridTextColumn Header="PID" Binding="{Binding PidText}" Width="60" SortMemberPath="Pid" ElementStyle="{StaticResource GridCellTextStyle}" />
                                        <DataGridTextColumn Header="协议" Binding="{Binding ProtocolDetail}" Width="78" SortMemberPath="ProtocolText" ElementStyle="{StaticResource GridCellTextStyle}" />
                                        <DataGridTextColumn Header="本地地址" Binding="{Binding LocalEndpoint}" Width="185" ElementStyle="{StaticResource GridCellTextStyle}" />
                                        <DataGridTextColumn Header="远程地址" Binding="{Binding RemoteEndpoint}" Width="185" ElementStyle="{StaticResource GridCellTextStyle}" />
                                        <DataGridTextColumn Header="TCP 状态" Binding="{Binding TcpStateText}" Width="105" ElementStyle="{StaticResource GridCellTextStyle}" />
                                        <DataGridTemplateColumn Header="策略状态" Width="165" SortMemberPath="PolicyText">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding PolicyBackground}" CornerRadius="2" Padding="5,1" HorizontalAlignment="Left" ToolTip="{Binding PolicyDetail}">
                                                        <TextBlock Text="{Binding PolicyText}" Foreground="{Binding PolicyBrush}" Style="{StaticResource GridCellTextStyle}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="说明" Binding="{Binding Notes}" Width="235" ElementStyle="{StaticResource GridCellTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="2" Background="{StaticResource HeaderSurfaceBrush}" BorderBrush="{StaticResource LightBorderBrush}" BorderThickness="0,1,0,0">
                                    <Grid Margin="8,0">
                                        <TextBlock Text="{Binding ConnectionVisibleText}" Style="{StaticResource SmallMutedTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedCountText}" Style="{StaticResource SmallMutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#E4E8ED" ShowsPreview="False" ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="25" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource HeaderSurfaceBrush}" BorderBrush="{StaticResource LightBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="系统进程" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="服务与 Windows 组件（按实际证据分类）" Style="{StaticResource SectionSubtleTitleStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SystemProcessCountText, StringFormat=共 {0} 项}" Style="{StaticResource SmallMutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="8,6,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="122" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="搜索" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" />
                        <TextBox x:Name="SystemProcessSearchBox" Grid.Column="1" Text="{Binding SystemProcessSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="按进程名、PID、路径、发布者搜索" />
                        <TextBlock Grid.Column="2" Text="筛选" Style="{StaticResource FieldLabelStyle}" Margin="8,0,6,0" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding SystemProcessFilters}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding SystemProcessFilterKey}" />
                    </Grid>

                    <DataGrid x:Name="SystemProcessGrid"
                              Grid.Row="2"
                              Style="{StaticResource DataGridStyle}"
                              ItemsSource="{Binding SystemProcessView}"
                              SelectionChanged="SystemProcessGrid_SelectionChanged"
                              MouseDoubleClick="Grid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="立即禁止…" Click="ContextBlock_Click" />
                                <MenuItem Header="延迟禁止…" Click="ContextSchedule_Click" />
                                <MenuItem Header="解除本工具规则…" Click="ContextUnblock_Click" />
                                <Separator />
                                <MenuItem Header="查看完整详情…" Click="OpenDetails_Click" />
                                <MenuItem Header="复制可执行文件路径" Click="CopySelectedPath_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="状态" Width="72" SortMemberPath="StateText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding NetworkStatusText}">
                                            <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource GridCellTextStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="进程名称" Binding="{Binding ProcessName}" Width="128" SortMemberPath="ProcessName" ElementStyle="{StaticResource GridCellTextStyle}" />
                            <DataGridTextColumn Header="PID" Binding="{Binding PidText}" Width="56" SortMemberPath="Pid" ElementStyle="{StaticResource GridCellTextStyle}" />
                            <DataGridTextColumn Header="路径" Binding="{Binding PathDisplay}" Width="190" ElementStyle="{StaticResource GridCellTextStyle}" />
                            <DataGridTextColumn Header="发布者" Binding="{Binding PublisherText}" Width="135" ElementStyle="{StaticResource GridCellTextStyle}" />
                            <DataGridTextColumn Header="连接" Binding="{Binding ConnectionCountText}" Width="62" ElementStyle="{StaticResource GridCellTextStyle}" />
                            <DataGridTemplateColumn Header="策略" Width="138" SortMemberPath="PolicyText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding PolicyBackground}" CornerRadius="2" Padding="5,1" HorizontalAlignment="Left" ToolTip="{Binding PolicyDetail}">
                                            <TextBlock Text="{Binding PolicyText}" Foreground="{Binding PolicyBrush}" Style="{StaticResource GridCellTextStyle}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="风险提示" Width="155" SortMemberPath="Risk">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ClassificationEvidence}">
                                            <Ellipse Width="7" Height="7" Fill="{Binding RiskBrush}" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding RiskSummary}" Style="{StaticResource GridCellTextStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" Background="{StaticResource HeaderSurfaceBrush}" BorderBrush="{StaticResource LightBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid Margin="8,0">
                            <TextBlock Text="{Binding SystemProcessVisibleText}" Style="{StaticResource SmallMutedTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="关键组件受保护；svchost 等不按进程整体阻断" Style="{StaticResource SmallMutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Details strip for the active selection. A separate window exposes the full text. -->
        <Border Grid.Row="4" Margin="8,6,8,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource HeaderSurfaceBrush}" BorderBrush="{StaticResource LightBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="9,0">
                        <TextBlock Text="选中项详情" Style="{StaticResource SectionTitleStyle}" FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="打开完整详情…" Style="{StaticResource LinkButtonStyle}" Click="OpenDetails_Click" IsEnabled="{Binding HasSelection}" />
                            <TextBlock Text="   " />
                            <Button Content="在资源管理器中定位" Style="{StaticResource LinkButtonStyle}" Click="OpenSelectedPath_Click" Visibility="{Binding HasSelectedPath, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="   " />
                            <Button Content="复制详情" Style="{StaticResource LinkButtonStyle}" Click="CopyDetails_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="9,4,9,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding SelectionTitle}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionTitle}" />
                        <TextBlock Text="{Binding SelectionSubtitle}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionSubtitle}" />
                        <TextBlock Text="{Binding SelectionLine1}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionLine1}" />
                        <TextBlock Text="{Binding SelectionLine2}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionLine2}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding SelectionLine3}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionLine3}" />
                        <TextBlock Text="{Binding SelectionLine4}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionLine4}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Bottom action area. Buttons are context-aware. -->
        <Border Grid.Row="5" Margin="8,6,8,0" Background="{StaticResource HeaderSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="9,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedCountText}" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding PendingTaskText}" Style="{StaticResource SmallMutedTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding LastOperationSummary}" Foreground="{Binding LastOperationBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0,12,0" ToolTip="{Binding LastOperationSummary}" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="立即禁止" Style="{StaticResource PrimaryBottomActionStyle}" Click="BlockButton_Click" IsEnabled="{Binding CanBlockSelected}" />
                    <Button Content="解除禁止" Style="{StaticResource BottomActionButtonStyle}" Click="UnblockButton_Click" IsEnabled="{Binding CanUnblockSelected}" />
                    <Button Content="延迟禁止 / 解除…" Style="{StaticResource BottomActionButtonStyle}" Click="ScheduleButton_Click" IsEnabled="{Binding CanScheduleSelected}" MinWidth="135" />
                    <Button Content="取消定时任务" Style="{StaticResource BottomActionButtonStyle}" Click="CancelTasksButton_Click" IsEnabled="{Binding CanCancelTasks}" />
                    <Button Content="任务与操作历史" Style="{StaticResource BottomActionButtonStyle}" Click="HistoryButton_Click" MinWidth="118" />
                    <Button Content="帮助" Style="{StaticResource BottomActionButtonStyle}" Click="HelpButton_Click" MinWidth="64" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="6" Background="#E9ECF0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastErrorMessage}" />
                    <TextBlock Text="{Binding BusyText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="数据目录" Style="{StaticResource LinkButtonStyle}" FontSize="11" Click="OpenDataFolder_Click" ToolTip="{Binding DataDirectory}" />
                    <TextBlock Text="  ·  F5 刷新  ·  Ctrl+F 搜索" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
