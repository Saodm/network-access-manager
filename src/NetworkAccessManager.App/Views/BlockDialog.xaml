<Window x:Class="NetworkAccessManager.App.Views.BlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认网络阻断"
        Width="780"
        Height="680"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,9">
            <TextBlock Text="确认建立网络阻断规则" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="HeaderHint" Text="请核对作用对象、方向和影响范围。确认后将通过标准 Windows UAC 请求管理员授权。"
                       Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border x:Name="ModePanel" Style="{StaticResource DialogSectionStyle}">
                    <StackPanel>
                        <TextBlock Text="阻断方式" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <RadioButton x:Name="ProgramModeRadio" GroupName="TargetMode" Content="按程序可执行文件路径阻断" Checked="TargetMode_Checked" />
                        <TextBlock Text="作用于此路径启动的全部实例，不只当前选中的 PID；对本机所有用户生效。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="22,1,0,5" TextWrapping="Wrap" />
                        <RadioButton x:Name="NetworkModeRadio" GroupName="TargetMode" Content="按远程 IP 地址 / 目标阻断" Checked="TargetMode_Checked" />
                        <TextBlock Text="会阻断所有访问该地址范围的程序，不限于当前选中的连接或进程；不限制端口。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="22,1,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DialogSectionStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="作用方向" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="OutboundRadio" Content="仅出站（推荐）" IsChecked="True" Checked="Direction_Checked" Margin="0,0,18,0" />
                            <RadioButton x:Name="InboundRadio" Content="仅入站" Checked="Direction_Checked" Margin="0,0,18,0" />
                            <RadioButton x:Name="BothRadio" Content="入站和出站" Checked="Direction_Checked" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="规则生效方式" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="EffectText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="影响范围" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ScopeText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource DialogSectionStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="将作用的对象" FontWeight="SemiBold" />
                            <TextBlock x:Name="ListSummaryText" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        </Grid>
                        <DataGrid x:Name="TargetGrid" Grid.Row="1" Style="{StaticResource DataGridStyle}" Height="220" MinHeight="145" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="92" ElementStyle="{StaticResource GridCellTextStyle}" />
                                <DataGridTextColumn Header="风险" Binding="{Binding RiskText}" Width="70" ElementStyle="{StaticResource GridCellTextStyle}" />
                                <DataGridTextColumn Header="对象" Binding="{Binding Display}" Width="160" ElementStyle="{StaticResource GridCellTextStyle}" />
                                <DataGridTextColumn Header="完整路径 / 地址与说明" Binding="{Binding Detail}" Width="*" MinWidth="230" ElementStyle="{StaticResource GridCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EmptyTargetsText" Grid.Row="1" Text="没有可用于此方式的对象。" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Border x:Name="RiskPanel" Style="{StaticResource DialogSectionStyle}" Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBorderBrush}">
                    <StackPanel>
                        <TextBlock Text="高风险提示" FontWeight="SemiBold" Foreground="{StaticResource OrangeBrush}" />
                        <TextBlock x:Name="RiskText" TextWrapping="Wrap" Margin="0,4,0,6" Foreground="{StaticResource OrangeBrush}" FontSize="11" />
                        <CheckBox x:Name="HighRiskAckCheckBox" Content="我已了解上述风险，确认继续进行阻断" Checked="Ack_Changed" Unchecked="Ack_Changed" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DialogSectionStyle}" Background="#F8FAFC">
                    <StackPanel>
                        <TextBlock Text="重要说明" FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                   Text="• Windows 防火墙规则按路径或目标地址生效，不对应单个 PID。&#10;• 本工具仅创建、管理和删除带有本工具身份元数据的规则，不会修改系统全局默认策略，也不会删除其他软件的规则。&#10;• 已建立的连接可能不会立即断开；新连接会按规则阻断。&#10;• 其他安全软件或组策略仍可能阻止或允许相应流量。" />
                        <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                   Text="确认后，程序会启动一次性管理员辅助进程；如果你在 UAC 中取消，则不会修改任何规则。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="SelectionSummaryText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource DialogButtonStyle}" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Content="确认并请求管理员授权" Style="{StaticResource PrimaryDialogButtonStyle}" MinWidth="168" IsDefault="True" Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
