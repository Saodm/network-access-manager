<Window x:Class="NetworkAccessManager.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="660"
        Height="580"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,9">
            <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="仅保存界面偏好；规则与定时任务保存在独立的数据目录中。" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource DialogSectionStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="自动刷新间隔" VerticalAlignment="Center" />
                        <ComboBox x:Name="IntervalComboBox" Grid.Column="1" Width="190" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="1" Text="自动刷新" VerticalAlignment="Center" Margin="0,12,0,0" />
                        <CheckBox x:Name="AutoRefreshCheckBox" Grid.Row="1" Grid.Column="1" Content="定期读取进程、连接和防火墙状态" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="2" Text="确认设置" VerticalAlignment="Top" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap"
                                   Text="高风险阻断、解除禁止、取消定时任务和批量操作始终需要明确确认；不能通过设置关闭这些安全步骤。" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource DialogSectionStyle}">
                    <StackPanel>
                        <TextBlock Text="数据与日志" FontWeight="SemiBold" Margin="0,0,0,7" />
                        <TextBlock Text="数据目录" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock x:Name="DataPathText" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" Margin="0,2,0,9" />
                        <TextBlock Text="日志目录" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock x:Name="LogPathText" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" Margin="0,2,0,9" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="打开数据目录" Style="{StaticResource ToolbarButtonStyle}" Click="OpenData_Click" Margin="0,0,6,0" />
                            <Button Content="打开日志目录" Style="{StaticResource ToolbarButtonStyle}" Click="OpenLogs_Click" />
                        </StackPanel>
                        <TextBlock x:Name="StorageHintText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DialogSectionStyle}">
                    <StackPanel>
                        <TextBlock Text="关于" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock x:Name="AboutText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,9,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedBrush}" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource DialogButtonStyle}" IsCancel="True" Click="Cancel_Click" />
                <Button Content="保存设置" Style="{StaticResource PrimaryDialogButtonStyle}" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
