<Window x:Class="NetworkAccessManager.App.Views.EthernetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="以太网控制"
        Width="680"
        Height="500"
        MinWidth="600"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource DialogSectionStyle}" Padding="10">
            <DockPanel>
                <Border x:Name="WarningPanel" DockPanel.Dock="Top" Background="{StaticResource WarningBackgroundBrush}"
                        BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="9,7" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="WarningText" Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap" FontSize="11" />
                        <CheckBox x:Name="AckCheck" Margin="0,8,0,0" Checked="Ack_Changed" Unchecked="Ack_Changed"
                                  Content="我已了解远程连接会立即断开，并确认在本机继续" />
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock x:Name="DetailText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>

                <DataGrid x:Name="AdapterGrid" Style="{StaticResource DataGridStyle}" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="适配器" Binding="{Binding Name}" Width="170" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" MinWidth="220" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="110" ElementStyle="{StaticResource GridCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,9,0,0">
            <TextBlock x:Name="FooterText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource DialogButtonStyle}" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Content="确认" Style="{StaticResource PrimaryDialogButtonStyle}" MinWidth="145" Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
