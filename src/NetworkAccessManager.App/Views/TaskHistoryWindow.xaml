<Window x:Class="NetworkAccessManager.App.Views.TaskHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务、规则与操作历史"
        Width="1180"
        Height="680"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="任务、规则与操作历史" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource ToolbarButtonStyle}" Click="Refresh_Click" />
                <Button Content="关闭" Style="{StaticResource ToolbarButtonStyle}" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource DialogSectionStyle}" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="搜索" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" />
                <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBox_TextChanged" ToolTip="按对象、状态、消息、ID 搜索" />
                <TextBlock Grid.Column="2" Text="筛选" Style="{StaticResource FieldLabelStyle}" Margin="10,0,6,0" />
                <ComboBox x:Name="FilterComboBox" Grid.Column="3" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="Filter_SelectionChanged" />
                <TextBlock x:Name="FirewallStateText" Grid.Column="4" Style="{StaticResource SmallMutedTextStyle}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="5" Width="80" Height="4" IsIndeterminate="True" x:Name="LoadingBar" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0" />
            </Grid>
        </Border>

        <TabControl x:Name="HistoryTabs" Grid.Row="2" SelectionChanged="HistoryTabs_SelectionChanged">
            <TabItem Header="定时任务">
                <DataGrid x:Name="TaskGrid" Style="{StaticResource DataGridStyle}" SelectionMode="Extended" SelectionChanged="TaskGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="状态" Width="150" SortMemberPath="StatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource GridCellTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="模式" Binding="{Binding ModeText}" Width="90" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="对象" Binding="{Binding DisplayTarget}" Width="170" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="方向" Binding="{Binding DirectionText}" Width="85" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="计划时间" Binding="{Binding PlannedText}" Width="145" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="剩余 / 时机" Binding="{Binding RemainingText}" Width="120" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="实际执行" Binding="{Binding StartedText}" Width="145" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="结果 / 失败原因" Binding="{Binding ResultText}" Width="300" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="任务 ID" Binding="{Binding TaskIdShort}" Width="85" ElementStyle="{StaticResource GridCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="已管理规则">
                <DataGrid x:Name="RuleGrid" Style="{StaticResource DataGridStyle}" SelectionMode="Extended" SelectionChanged="RuleGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="实际状态" Width="160" SortMemberPath="StatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding StatusDetail}">
                                        <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource GridCellTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="类型" Binding="{Binding TargetKindText}" Width="75" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="对象" Binding="{Binding TargetText}" Width="*" MinWidth="220" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="方向" Binding="{Binding DirectionText}" Width="75" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedText}" Width="145" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="防火墙规则名" Binding="{Binding FirewallRuleName}" Width="210" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="规则 ID" Binding="{Binding RuleIdShort}" Width="85" ElementStyle="{StaticResource GridCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="操作历史">
                <DataGrid x:Name="HistoryGrid" Style="{StaticResource DataGridStyle}" SelectionMode="Extended" SelectionChanged="HistoryGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="145" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="110" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="对象" Binding="{Binding TargetText}" Width="190" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTemplateColumn Header="结果" Width="75" SortMemberPath="OutcomeText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding OutcomeBrush}" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding OutcomeText}" Style="{StaticResource GridCellTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="260" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="失败原因 / 详情" Binding="{Binding Detail}" Width="220" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="计划时间" Binding="{Binding PlannedText}" Width="135" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="实际执行" Binding="{Binding ActualText}" Width="135" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="规则/任务" Binding="{Binding Identifiers}" Width="150" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="80" ElementStyle="{StaticResource GridCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{StaticResource HeaderSurfaceBrush}" BorderBrush="{StaticResource LightBorderBrush}" BorderThickness="0,1,0,0" Padding="9,6" Margin="0,0,0,7">
            <StackPanel>
                <TextBlock x:Name="VisibleCountText" Style="{StaticResource SmallMutedTextStyle}" />
                <TextBlock x:Name="SelectionDetailText" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" MaxHeight="96" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CancelTaskButton" Content="取消选中定时任务…" Style="{StaticResource BottomActionButtonStyle}" Click="CancelTask_Click" IsEnabled="False" />
                <Button x:Name="UnblockRuleButton" Content="解除选中目标的规则…" Style="{StaticResource BottomActionButtonStyle}" Click="UnblockRule_Click" IsEnabled="False" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyDetailsButton" Content="复制详情" Style="{StaticResource BottomActionButtonStyle}" Click="CopyDetails_Click" IsEnabled="False" />
                <Button Content="关闭" Style="{StaticResource PrimaryBottomActionStyle}" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
